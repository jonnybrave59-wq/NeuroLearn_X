# Production template. Store the real values in deployment secrets, never Git.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Supabase Free persistent storage for original Question Studio uploads.
# Keep the service-role key only in the backend environment.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=learning-materials
SUPABASE_STORAGE_TIMEOUT_SECONDS=30

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

# Production-only replacements for the published local demo passwords. These
# are applied only while an imported account still uses its known development
# password, so later user password changes are preserved across redeployments.
PRODUCTION_TEACHER_PASSWORD=replace-with-a-strong-private-password
PRODUCTION_DEMO_STUDENT_PASSWORD=replace-with-a-different-strong-private-password

# HTTPS-only HTTP-only cookie. SameSite=lax is sufficient for the bundled
# same-origin web deployment. Use none when CAPACITOR_ORIGINS or another
# separately hosted HTTPS frontend is enabled.
COOKIE_SECURE=1
COOKIE_SAMESITE=lax

# Exact approved HTTPS origins only. Never use a wildcard with credentials.
ALLOWED_ORIGINS=https://your-neurolearnx-app.vercel.app

# Required only for AI-assisted module analysis and question generation.
# Keys stay in the backend environment and are never exposed to the browser.
AI_PROVIDER=openai-compatible
AI_MODEL=your-supported-model
AI_API_KEY=replace-with-provider-api-key
AI_BASE_URL=https://api.openai.com/v1
AI_REQUEST_TIMEOUT_SECONDS=90

# Optional native client origins. Keep empty for a web-only deployment.
CAPACITOR_ORIGINS=

# Alembic is preferred in deployed environments; this development convenience is safe with checkfirst.
CREATE_TABLES_ON_STARTUP=0

# Seed synthetic demo accounts at container startup. Set to 0 after initial seed
# if the deployment uses multiple always-on instances.
SEED_DEMO_ON_STARTUP=0
SEED_DEMO_IF_EMPTY=0

# PostgreSQL pool and timeout limits. These defaults fit one small production
# web process and prevent stalled database operations from consuming all work.
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=1
DB_POOL_RECYCLE_SECONDS=300
DB_POOL_TIMEOUT_SECONDS=15

# Teacher document-authoring limits. Uploads are validated by extension, MIME
# type, file signature, compressed expansion size, and readable-text length.
MAX_UPLOAD_SIZE_MB=10
MAX_EXTRACTED_TEXT_CHARS=250000
UPLOAD_PROCESSING_TIMEOUT_SECONDS=45
LOG_LEVEL=INFO

# Production process limits. Keep one web process unless the selected plan and
# connection-pool budget are increased together.
UVICORN_LIMIT_CONCURRENCY=100
UVICORN_TIMEOUT_KEEP_ALIVE_SECONDS=5
UVICORN_GRACEFUL_SHUTDOWN_SECONDS=30
FORWARDED_ALLOW_IPS=*

# Required canonical deployment URL. Share links discard all query parameters,
# credentials, authentication state, and non-root routes.
PUBLIC_APP_URL=https://your-neurolearnx-app.vercel.app
VITE_PUBLIC_APP_URL=https://your-neurolearnx-app.vercel.app

# Leave unset for the browser deployment so the PWA uses same-origin `/api`
# routes. Set this only for a separate client such as the bundled Android app;
# the value must be the public HTTPS backend origin.
VITE_API_BASE_URL=
VITE_SOURCE_AVAILABLE=false
VITE_SHOW_DEMO_CREDENTIALS=false

# Keep false until release/NeuroLearn-X.apk is a real, tested APK.
VITE_APK_AVAILABLE=false

# Keep false until release/NeuroLearn-X-Shareable.zip has been built with the
# permanent HTTPS deployment URL and tested on another Windows computer.
VITE_WINDOWS_PACKAGE_AVAILABLE=false
