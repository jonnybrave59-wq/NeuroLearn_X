APP_ENV=production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@db:5432/neurolearnx
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
PRODUCTION_TEACHER_PASSWORD=replace-with-a-unique-private-password
PRODUCTION_DEMO_STUDENT_PASSWORD=replace-with-a-different-private-password
COOKIE_SECURE=1
COOKIE_SAMESITE=lax
PUBLIC_APP_URL=https://your-neurolearnx-domain.example
ALLOWED_ORIGINS=https://your-neurolearnx-domain.example
CAPACITOR_ORIGINS=
CREATE_TABLES_ON_STARTUP=0
SEED_DEMO_ON_STARTUP=0
SEED_DEMO_IF_EMPTY=0
LOG_LEVEL=INFO
PORT=8000
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=300
DB_POOL_TIMEOUT_SECONDS=15
MAX_UPLOAD_SIZE_MB=10
MAX_EXTRACTED_TEXT_CHARS=250000
UPLOAD_PROCESSING_TIMEOUT_SECONDS=45
AI_PROVIDER=openai-compatible
AI_MODEL=replace-with-a-supported-model-name
AI_API_KEY=replace-in-the-provider-secret-manager
AI_BASE_URL=https://api.openai.com/v1
AI_REQUEST_TIMEOUT_SECONDS=90
UVICORN_LIMIT_CONCURRENCY=100
UVICORN_TIMEOUT_KEEP_ALIVE_SECONDS=5
UVICORN_GRACEFUL_SHUTDOWN_SECONDS=30
